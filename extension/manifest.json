{
  "manifest_version": 3,
  "name": "RAM Limiter for Chrome",
  "version": "1.1.0",
  "description": "Limita a memória usada pelo Chrome: suspende abas em segundo plano quando o limite que você definiu for ultrapassado.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "storage", "alarms", "system.memory", "nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RAM Limiter for Chrome",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
